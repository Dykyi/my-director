{
  "name": "mydirector",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.32",
    "expo-build-properties": "~57.0.23",
    "expo-dev-client": "~57.0.21",
    "expo-image": "~57.0.5",
    "expo-sharing": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@jest/globals": "~29.7.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "livekit-server-sdk": "^2.19.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "token": "node --env-file=.env.local tools/livekit-token/token.mjs",
    "pull": "set -a && . ./.env.local && set +a && tools/device/pull-recordings.sh",
    "stand": "set -a && . ./.env.local && set +a && tools/device/stand.sh",
    "test": "jest",
    "record": "tools/device/record-screen.sh"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tools/"
    ]
  }
}
