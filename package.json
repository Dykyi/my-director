  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@jest/globals": "~29.7.0",
    "@react-native/jest-preset": "0.86.3",
    "@storybook/addon-ondevice-actions": "^10.6",
    "@storybook/addon-ondevice-controls": "^10.6",
    "@storybook/react-native": "^10.6",
    "@types/node": "^26.6.6",
    "@types/react": "~19.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "prettier": "^3.9.10",
    "react-native-svg-transformer": "^1.5.3",
    "storybook": "^10.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo run:android -d",
    "ios": "npx expo run:ios -d",
    "web": "npx expo start --web",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "typecheck": "tsc --noEmit && tsc -p tools/interviewer",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "token": "node --env-file=.env.local tools/livekit-token/token.mjs",
    "interviewer": "node --env-file=.env.local tools/interviewer/server/main.ts",
    "test:interviewer": "node --test 'tools/interviewer/**/*.test.ts'",
    "icons": "python3 tools/icons/make-icons.py",
    "tokens": "node --import tsx tools/design-tokens/generate.ts",
    "pull": "tools/device/pull-recordings.sh",
    "stand": "tools/device/stand.sh",
    "test": "jest",
    "record": "tools/device/record-screen.sh"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "\\.svg$": "<rootDir>/src/test/svg-mock.tsx"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tools/"
    ]
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
