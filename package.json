{
  "name": "mydirector",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "start": "yarn workspace @mydirector/mobile start",
    "ios": "yarn workspace @mydirector/mobile ios",
    "lint": "yarn workspace @mydirector/mobile lint",
    "lint:fix": "yarn workspace @mydirector/mobile lint:fix",
    "test:native": "yarn workspace @mydirector/mobile test:native",
    "token": "yarn workspace @mydirector/mobile token",
    "icons": "yarn workspace @mydirector/mobile icons",
    "tokens": "yarn workspace @mydirector/mobile tokens",
    "stand": "yarn workspace @mydirector/mobile stand",
    "pull": "yarn workspace @mydirector/mobile pull",
    "record": "yarn workspace @mydirector/mobile record",
    "interviewer": "yarn workspace @mydirector/interviewer start",
    "mobile": "yarn workspace @mydirector/mobile",
    "upload-api": "yarn workspace @mydirector/upload-api",
    "test": "yarn workspaces foreach --all --exclude mydirector --verbose run test",
    "typecheck": "yarn workspaces foreach --all --exclude mydirector --verbose run typecheck",
    "test:verify": "tools/verify/.venv/bin/pytest tools/verify/tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "yarn format:check && yarn typecheck && yarn lint && yarn test && yarn test:native && yarn test:verify"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "prettier": "^3.9.10"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
