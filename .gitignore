# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# yarn 4 (corepack pins the version in package.json)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# native projects are generated by prebuild (CNG)
/apps/mobile/ios
/apps/mobile/android

# secrets
.env.local

# local documents and device artifacts
.ovis/
pulled/
evidence/*
!evidence/SUMMARY.md
tools/verify/fixtures/
tools/verify/.venv/
apps/interviewer/.speech-cache/
services/upload-api/.wrangler/
__pycache__/
.build/

