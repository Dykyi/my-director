{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@app/*": ["./src/app/*"],
      "@assets/*": ["./assets/*"],
      "@config/*": ["./src/config/*"],
      "@features/*": ["./src/features/*"],
      "@modules/*": ["./modules/*"],
      "@shared/*": ["./src/shared/*"],
      "@test/*": ["./src/test/*"],
      "@theme/*": ["./src/theme/*"],
      "@ui/*": ["./src/ui/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["tools/upload-api"]
}
