{
  "name": "@mydirector/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo run:android -d",
    "ios": "npx expo run:ios -d",
    "web": "npx expo start --web",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:native": "swift test --package-path modules/capture-core && swift test --package-path modules/background-upload",
    "token": "node --env-file=../../.env.local scripts/livekit-token.mjs",
    "icons": "python3 scripts/make-icons.py",
    "tokens": "node --import tsx scripts/design-tokens.ts",
    "stand": "scripts/stand.sh",
    "pull": "scripts/pull-recordings.sh",
    "record": "scripts/record-screen.sh"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "class-variance-authority": "^0.7.1",
    "expo": "~57.0.32",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.23",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.23",
    "expo-dev-client": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.30",
    "expo-splash-screen": "~57.0.11",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.27",
    "expo-video": "~57.0.5",
    "lucide-react-native": "^1.70.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "uniwind": "^1.13.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "~29.7.0",
    "@mydirector/design-system": "workspace:^",
    "@react-native/jest-preset": "0.86.3",
    "@storybook/addon-ondevice-actions": "^10.6",
    "@storybook/addon-ondevice-controls": "^10.6",
    "@storybook/react-native": "^10.6",
    "@types/node": "^26.6.6",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "livekit-server-sdk": "^2.19.2",
    "react-native-svg-transformer": "^1.5.3",
    "storybook": "^10.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "\\.svg$": "<rootDir>/src/test/svg-mock.tsx"
    },
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
