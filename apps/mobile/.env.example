# Read by Expo CLI from this folder only. EXPO_PUBLIC_* values are inlined into the app bundle (POC only).

# The upload Worker's URL and the UPLOAD_API_TOKEN from the root .env.local. The Worker also issues the call token.
EXPO_PUBLIC_UPLOAD_API_URL=
EXPO_PUBLIC_UPLOAD_API_TOKEN=

# Apple Developer team that signs device builds (Xcode > Settings > Accounts). Read by app.config.ts.
APPLE_TEAM_ID=
