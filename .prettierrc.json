{
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "importOrder": [
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@modules/(.*)$",
    "",
    "^@(assets|config|features|shared|test|theme|ui)/(.*)$",
    "",
    "^[.]"
  ],
  "importOrderTypeScriptVersion": "6.0.0"
}
