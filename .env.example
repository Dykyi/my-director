# Secrets for the tools on the Mac (interviewer server, token generator, Worker and device scripts).
# The app reads its own apps/mobile/.env.local.

# LiveKit Cloud project, Settings > Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Backblaze B2 for scenario E, S3-compatible API. Used by the upload Worker and its scripts.
B2_S3_ENDPOINT=https://s3.<region>.backblazeb2.com
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
# Shared secret between the app and the upload Worker: openssl rand -hex 32
UPLOAD_API_TOKEN=
# Cloudflare API token (Edit Cloudflare Workers) for `yarn deploy:api` and `yarn tail:api`.
CLOUDFLARE_API_TOKEN=

# Identifier from `xcrun devicectl list devices`, used by `yarn stand` and `yarn pull`.
DEVICE=
