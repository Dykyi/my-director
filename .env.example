# LiveKit Cloud project, Settings > Keys. Used only by tools on the Mac.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Printed by `npm run token`. Inlined into the app bundle at build time (POC only).
EXPO_PUBLIC_LIVEKIT_URL=
EXPO_PUBLIC_LIVEKIT_TOKEN=

# Scenario E, see plan-upload.md
EXPO_PUBLIC_UPLOAD_API_URL=
EXPO_PUBLIC_UPLOAD_API_TOKEN=

# Backblaze B2 for scenario E, S3-compatible API. Used only by the upload Worker and tools on the Mac.
B2_S3_ENDPOINT=https://s3.<region>.backblazeb2.com
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
# Shared secret between the app and the upload Worker: openssl rand -hex 32
UPLOAD_API_TOKEN=

# Identifier from `xcrun devicectl list devices`, used by `npm run pull`.
DEVICE=
