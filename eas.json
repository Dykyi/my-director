{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "base": {
      "node": "24.14.1",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0",
        "resourceClass": "medium"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview"
    },
    "development": {
      "extends": "preview",
      "developmentClient": true,
      "channel": "development"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6833037876"
      }
    }
  }
}
